# ═══════════════════════════════════════════════════════════
# MULTIPLE LLM API KEYS — use any or all (all have free tiers)
# ═══════════════════════════════════════════════════════════

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier, ultra-fast) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free models available) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Hugging Face (free tier) — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenAI (paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (paid) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Agent-to-Model Routing ───────────────────────────────
# Each agent uses a DIFFERENT provider — mix free + paid for best results.
# If a provider key isn't set, the agent auto-falls back to the first
# available provider.
#
#   Researcher   → Gemini     (great at research + web search)
#   Architect    → OpenAI     (gpt-4o-mini, best at planning)
#   Implementer  → Anthropic  (Claude, best at writing code)
#   Critic       → OpenAI     (gpt-4o-mini, best at analysis)
#   Tester       → Groq       (ultra-fast test generation)
#   DevOps       → Gemini     (good at config + infra)
RESEARCHER_LLM=gemini
ARCHITECT_LLM=openai
IMPLEMENTER_LLM=anthropic
CRITIC_LLM=openai
TESTER_LLM=groq
DEVOPS_LLM=gemini

# ═══════════════════════════════════════════════════════════
# SUPABASE (auto-filled from your Supabase project)
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=https://hqmskhywllcyievplmsm.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=10000
