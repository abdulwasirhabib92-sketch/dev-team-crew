# ═══════════════════════════════════════════════════════════
# MULTIPLE LLM API KEYS — use any or all (all have free tiers)
# ═══════════════════════════════════════════════════════════

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier, ultra-fast) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free models available) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Hugging Face (free tier) — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenAI (optional, paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional, paid) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Agent-to-Model Routing ───────────────────────────────
# Assign which provider each agent uses (overrides auto-routing)
# Format: agent_name=provider:model
RESEARCHER_LLM=gemini
ARCHITECT_LLM=groq
IMPLEMENTER_LLM=gemini
CRITIC_LLM=groq
TESTER_LLM=gemini
DEVOPS_LLM=groq

# Server
PORT=10000
